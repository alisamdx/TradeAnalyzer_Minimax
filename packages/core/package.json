{
  "name": "@tradeanalyzer/core",
  "version": "0.6.42",
  "private": true,
  "description": "Shared, Electron-free core for the TradeAnalyzer rebuild: dictionary, collector, ingestion, quality gate, provider parsers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./dictionary": {
      "types": "./dist/dictionary/index.d.ts",
      "import": "./dist/dictionary/index.js"
    },
    "./collector": {
      "types": "./dist/collector/index.d.ts",
      "import": "./dist/collector/index.js"
    },
    "./qa": {
      "types": "./dist/qa/index.d.ts",
      "import": "./dist/qa/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run lint && npm run rebuild:node --prefix ../.."
  },
  "peerDependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
